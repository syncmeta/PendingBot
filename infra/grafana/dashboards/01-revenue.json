{
  "__inputs": [
    {
      "name": "DS_SUPABASE",
      "label": "Supabase Postgres (metabase_ro)",
      "description": "Read-only Supabase Postgres datasource",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Topups, refunds, net revenue and refund rate. Source: pendingbot.topups (paid_amount_minor / paid_currency / status / channel) + pendingbot.billing_ledger (entry_type, delta_credits).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "title": "Gross paid (verified topups, window)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(paid_amount_minor), 0) / 100.0 AS gross_paid\nFROM pendingbot.topups\nWHERE status = 'verified'\n  AND paid_amount_minor IS NOT NULL\n  AND is_sandbox = false\n  AND $__timeFilter(created_at);",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "title": "Refunded amount (window)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(paid_amount_minor), 0) / 100.0 AS refunded\nFROM pendingbot.topups\nWHERE status = 'refunded'\n  AND paid_amount_minor IS NOT NULL\n  AND is_sandbox = false\n  AND $__timeFilter(created_at);",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "title": "Net revenue (gross − refunds)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (\n  COALESCE(SUM(paid_amount_minor) FILTER (WHERE status = 'verified'), 0)\n  - COALESCE(SUM(paid_amount_minor) FILTER (WHERE status = 'refunded'), 0)\n) / 100.0 AS net_revenue\nFROM pendingbot.topups\nWHERE paid_amount_minor IS NOT NULL\n  AND is_sandbox = false\n  AND $__timeFilter(created_at);",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "description": "Alert-friendly: refund rate = refunded amount / gross paid amount over the window. Wire a Grafana alert on this panel (see README 'Alerting').",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "title": "Refund rate (alert candidate)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE\n  WHEN COALESCE(SUM(paid_amount_minor) FILTER (WHERE status = 'verified'), 0) = 0 THEN 0\n  ELSE COALESCE(SUM(paid_amount_minor) FILTER (WHERE status = 'refunded'), 0)::numeric\n       / NULLIF(SUM(paid_amount_minor) FILTER (WHERE status = 'verified'), 0)\nEND AS refund_rate\nFROM pendingbot.topups\nWHERE paid_amount_minor IS NOT NULL\n  AND is_sandbox = false\n  AND $__timeFilter(created_at);",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "description": "Daily gross paid vs refunded (fiat, USD-normalised by paid_currency assumption — see README caveat on multi-currency).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "12.0.0",
      "title": "Daily gross paid vs refunded",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(created_at, '1d') AS time,\n  SUM(paid_amount_minor) FILTER (WHERE status = 'verified') / 100.0 AS \"gross_paid\",\n  SUM(paid_amount_minor) FILTER (WHERE status = 'refunded') / 100.0 AS \"refunded\"\nFROM pendingbot.topups\nWHERE paid_amount_minor IS NOT NULL\n  AND is_sandbox = false\n  AND $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "description": "Topup count + paid amount by channel (apple_iap / stripe / redemption / admin_grant / signup_bonus / adjust).",
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 6,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "pluginVersion": "12.0.0",
      "title": "Topups by channel & status (window)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  channel,\n  status,\n  COUNT(*) AS topup_count,\n  COALESCE(SUM(paid_amount_minor), 0) / 100.0 AS paid_amount,\n  COALESCE(SUM(credits_granted), 0) AS credits_granted\nFROM pendingbot.topups\nWHERE is_sandbox = false\n  AND $__timeFilter(created_at)\nGROUP BY channel, status\nORDER BY channel, status;",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 41,
  "tags": ["pendingbot", "revenue", "billing"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "PendingBot — Revenue",
  "uid": "pb-revenue",
  "version": 1,
  "weekStart": ""
}

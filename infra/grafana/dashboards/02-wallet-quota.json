{
  "__inputs": [
    {
      "name": "DS_SUPABASE",
      "label": "Supabase Postgres (metabase_ro)",
      "description": "Read-only Supabase Postgres datasource",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "12.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Wallet balances per subject (pendingbot.subject_wallets) and overdraft / negative-balance list. Credits are integer 'credits' units, not fiat.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "locale" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "12.0.0",
      "title": "Total credits outstanding (all wallets)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(balance_credits), 0) AS total_credits\nFROM pendingbot.subject_wallets;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "12.0.0",
      "title": "Funded wallets (balance > 0)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS funded_wallets\nFROM pendingbot.subject_wallets\nWHERE balance_credits > 0;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "description": "Alert-friendly: number of wallets in overdraft (balance < 0). Wire an alert if this exceeds an acceptable threshold.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "12.0.0",
      "title": "Overdrawn wallets (balance < 0)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS overdrawn_wallets\nFROM pendingbot.subject_wallets\nWHERE balance_credits < 0;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "locale" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "12.0.0",
      "title": "Lifetime credits spent (all subjects)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(lifetime_spent_credits), 0) AS lifetime_spent\nFROM pendingbot.subject_wallets;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "description": "Overdraft / negative-balance list — subjects whose wallet is below zero, most negative first.",
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "pluginVersion": "12.0.0",
      "title": "Overdraft list (negative balances)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.id AS subject_id,\n  s.display_name,\n  s.subject_type,\n  s.kind,\n  w.balance_credits,\n  w.lifetime_topup_credits,\n  w.lifetime_spent_credits,\n  w.balance_updated_at\nFROM pendingbot.subject_wallets w\nJOIN pendingbot.subjects s ON s.id = w.subject_id\nWHERE w.balance_credits < 0\nORDER BY w.balance_credits ASC\nLIMIT 200;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "description": "Balance distribution by subject_type (human vs group vs whatever subject_type values exist).",
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 6,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "pluginVersion": "12.0.0",
      "title": "Balance aggregation by subject_type",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.subject_type,\n  COUNT(*) AS wallet_count,\n  COALESCE(SUM(w.balance_credits), 0) AS total_balance,\n  COALESCE(SUM(w.lifetime_topup_credits), 0) AS total_lifetime_topup,\n  COALESCE(SUM(w.lifetime_spent_credits), 0) AS total_lifetime_spent\nFROM pendingbot.subject_wallets w\nJOIN pendingbot.subjects s ON s.id = w.subject_id\nGROUP BY s.subject_type\nORDER BY total_balance DESC;",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 41,
  "tags": ["pendingbot", "wallet", "quota"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "PendingBot — Wallet & Quota",
  "uid": "pb-wallet-quota",
  "version": 1,
  "weekStart": ""
}

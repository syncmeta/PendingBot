        "pluginVersion": "12.0.0",
        "title": "Net credits issued (topups \u2212 refunds, PNC)",
        "type": "stat",
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "cfo4bmc9o50xsc"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COALESCE(SUM(delta_pnc_micros), 0) / 1e6 AS net_credits_pnc\nFROM pendingbot.pnc_ledger;",
            "refId": "A"
          }
        ]

        "description": "Net credits issued (topups \u2212 refunds) per subject, from pnc_ledger. NOT a live balance (no consumption here). Highest net first.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false

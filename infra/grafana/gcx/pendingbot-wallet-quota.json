              "type": "postgres",
              "uid": "cfo4bmc9o50xsc"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS funded_subjects\nFROM (\n  SELECT subject_id, SUM(delta_pnc_micros) AS net\n  FROM pendingbot.pnc_ledger\n  GROUP BY subject_id\n) t\nWHERE t.net > 0;",
            "refId": "A"
          }

        "pluginVersion": "12.0.0",
        "title": "Net credits issued by subject (issued \u2212 refunded)",
        "type": "table",
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "cfo4bmc9o50xsc"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  s.id AS subject_id,\n  s.display_name,\n  s.subject_type,\n  s.kind,\n  COALESCE(SUM(l.delta_pnc_micros) FILTER (WHERE l.kind = 'topup'), 0) / 1e6 AS topup_pnc,\n  COALESCE(SUM(ABS(l.delta_pnc_micros)) FILTER (WHERE l.kind = 'refund'), 0) / 1e6 AS refund_pnc,\n  COALESCE(SUM(l.delta_pnc_micros), 0) / 1e6 AS net_pnc,\n  MAX(l.created_at) AS last_activity\nFROM pendingbot.pnc_ledger l\nJOIN pendingbot.subjects s ON s.id = l.subject_id\nGROUP BY s.id, s.display_name, s.subject_type, s.kind\nORDER BY net_pnc DESC\nLIMIT 200;",
            "refId": "A"
          }
        ]
      },

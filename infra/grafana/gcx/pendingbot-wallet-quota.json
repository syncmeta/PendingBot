        "pluginVersion": "12.0.0",
        "title": "Net credits by subject_type",
        "type": "table",
        "targets": [
          {
            "datasource": {
              "type": "postgres",
              "uid": "cfo4bmc9o50xsc"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  s.subject_type,\n  COUNT(DISTINCT l.subject_id) AS subject_count,\n  COALESCE(SUM(l.delta_pnc_micros) FILTER (WHERE l.kind = 'topup'), 0) / 1e6 AS total_topup_pnc,\n  COALESCE(SUM(ABS(l.delta_pnc_micros)) FILTER (WHERE l.kind = 'refund'), 0) / 1e6 AS total_refund_pnc,\n  COALESCE(SUM(l.delta_pnc_micros), 0) / 1e6 AS net_pnc\nFROM pendingbot.pnc_ledger l\nJOIN pendingbot.subjects s ON s.id = l.subject_id\nGROUP BY s.subject_type\nORDER BY net_pnc DESC;",
            "refId": "A"
          }
        ]

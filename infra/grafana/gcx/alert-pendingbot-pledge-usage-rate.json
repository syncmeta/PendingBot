{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "pendingbot-pledge-usage-rate",
    "annotations": {
      "grafana.app/folder": "pendingbot"
    }
  },
  "spec": {
    "title": "PendingBot \u2014 Group pledge usage rate high",
    "trigger": {
      "interval": "1m"
    },
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "5m",
    "labels": {
      "app": "pendingbot",
      "severity": "warning"
    },
    "annotations": {
      "summary": "Group pledge usage rate (\u5b9e\u7f34 contributed / \u8ba4\u7f34 pledged) is above 90%.",
      "__dashboardUid__": "pendingbot-group-pool",
      "__panelId__": "2"
    },
    "panelRef": {
      "dashboardUID": "pendingbot-group-pool",
      "panelID": 2
    },
    "expressions": {
      "A": {
        "queryType": "",
        "relativeTimeRange": {
          "from": "600s",
          "to": "0s"
        },
        "datasourceUID": "cfo4bmc9o50xsc",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cfo4bmc9o50xsc"
          },
          "rawSql": "SELECT CASE\n  WHEN COALESCE(active_pledged_micros, 0) = 0 THEN 0\n  ELSE active_contributed_micros::numeric / NULLIF(active_pledged_micros, 0)\nEND AS pledge_usage_rate\nFROM pendingbot.bi_group_pool_summary;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          }
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "source": true,
        "model": {
          "refId": "C",
          "type": "threshold",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "conditions": [
            {
              "type": "query",
              "evaluator": {
                "type": "gt",
                "params": [
                  0.9
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "C"
                ]
              },
              "reducer": {
                "type": "last",
                "params": []
              }
            }
          ]
        }
      }
    }
  }
}

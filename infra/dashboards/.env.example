# PendingBot dashboard stack — environment template.
#
# Copy to `.env` on the VPS and fill in. NEVER commit the real .env.
# Generate strong random values with: openssl rand -base64 32
# Bring the stack up with:  docker compose --env-file .env up -d

# ── Metabase metadata Postgres ──────────────────────────────────────────────
# Password for Metabase's OWN state database (the "metabase-db" container).
# Used by both metabase-db (POSTGRES_PASSWORD) and metabase (MB_DB_PASS).
MB_METADATA_DB_PASSWORD=

# Encrypts datasource credentials Metabase stores (e.g. the bi_ro
# password). Set once and keep stable — rotating it invalidates saved secrets.
# Generate: openssl rand -base64 32
MB_ENCRYPTION_SECRET_KEY=

# ── Supabase read-only connection (entered in the Metabase UI, kept here for
#    reference / backup so you don't lose it) ─────────────────────────────────
# These are NOT consumed by docker-compose directly; you type them into the
# Metabase "Add database" form. Stored here so the .env is the single source of
# truth for VPS migration.
#
# Host: direct  -> db.<project-ref>.supabase.co
#       pooler  -> aws-0-<region>.pooler.supabase.com   (session mode, port 5432)
# With the pooler, MB_DB_SUPABASE_USER must be   bi_ro.<project-ref>
MB_DB_SUPABASE_HOST=
MB_DB_SUPABASE_PORT=5432
MB_DB_SUPABASE_DBNAME=postgres
MB_DB_SUPABASE_USER=bi_ro
# Password set out-of-band via:
#   supabase db query --linked "ALTER ROLE bi_ro WITH PASSWORD '<value>';"
MB_DB_SUPABASE_PASS=
MB_DB_SUPABASE_SCHEMA=pendingbot

# ── Appsmith ────────────────────────────────────────────────────────────────
# Both encrypt Appsmith datasource credentials at rest. Set once, keep stable,
# back up — losing them makes saved datasources unreadable.
# Generate each: openssl rand -base64 24
APPSMITH_ENCRYPTION_PASSWORD=
APPSMITH_ENCRYPTION_SALT=
# Public https URL Appsmith is served at (reverse proxy), e.g.
#   https://admin.pendingname.com
APPSMITH_CUSTOM_DOMAIN=

# Edge REST base URL that Appsmith datasources point at (the deployed worker),
# kept here for reference. Configure inside Appsmith datasources, not compose.
APPSMITH_EDGE_API_BASE=https://api.pendingname.com

# ── Backups to Cloudflare R2 (used by the pg_dump cron — see runbook) ────────
# An R2 bucket + an S3-compatible API token (Access Key ID / Secret).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pendingbot-dashboard-backups
# Derived endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

{
  "name": "pendingbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:edge": "bun --filter='@pendingbot/edge' dev",
    "dev:web": "bun --filter='@pendingbot/web' dev",
    "dev:board": "bun --filter='@pendingbot/board' dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "zod": "3.25.76"
  }
}

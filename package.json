{
  "name": "pendingbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:edge": "bun --filter='@pendingbot/edge' dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "supabase:advisor:gate": "bun scripts/supabase-advisor-gate.ts --allowlist docs/supabase-advisor-allowlist.json",
    "supabase:advisor:test": "bun scripts/test-supabase-advisor-gate.ts",
    "db:definer:gate": "bun scripts/definer-execute-gate.ts --allowlist docs/definer-execute-allowlist.json",
    "db:definer:gate:local": "supabase db query --local -o json -f scripts/sql/definer-execute-audit.sql | bun run db:definer:gate -",
    "db:definer:gate:linked": "supabase db query --linked -o json -f scripts/sql/definer-execute-audit.sql | bun run db:definer:gate -",
    "db:definer:test": "bun scripts/test-definer-execute-gate.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "hono": "4.12.22",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "vite": "6.4.2",
    "ws": "8.21.0"
  }
}

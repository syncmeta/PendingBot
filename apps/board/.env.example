# Supabase project (the same project the edge worker talks to).
# For local dev these come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser. Used to bypass RLS for
# admin reads/writes against pendingbot.llm_providers, audit_log, etc.
SUPABASE_SERVICE_ROLE_KEY=

# Optional system proxy for server-side fetch (Supabase JS, server
# actions, anything the Node runtime calls out to). Node's built-in
# fetch ignores these vars by default — instrumentation.ts wires
# undici's ProxyAgent so they actually take effect. Leave blank for
# direct outbound. macOS Clash/V2Ray defaults: http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

# Cloudflare Turnstile site key — must be set when Supabase Auth has
# captcha protection enabled (Dashboard → Authentication → Captcha),
# otherwise signInWithPassword 直接被拒。Public by design (the matching
# secret lives on Supabase). Live key is the same one the iOS client
# uses; localhost is allowed by Turnstile by default, so the local
# dev server just works. Leave blank only if captcha is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Copy to `.dev.vars` (gitignored) and fill in for local `wrangler dev`.
# In CI / deploy, use `wrangler secret put --env <env> <KEY>`.

# Cloudflare account
CF_ACCOUNT_ID=

# Supabase (local `supabase start`)
# New-format API keys (sb_publishable_… / sb_secret_…). For a local stack,
# `supabase status` prints them; legacy anon/service_role JWT values also
# still work here until end of 2026 if your CLI stack predates the new keys.
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# CORS origin for dev (web client URL)
ALLOWED_ORIGIN=http://localhost:5173

# LLM
OPENROUTER_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=

# Sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io

# Memory
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=

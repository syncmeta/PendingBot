# Copy to scripts/.secrets.local and fill in. .secrets.local is git-ignored.
# Sourced by push-secrets.sh.

# Apple Developer Team ID (10-char alphanumeric).
APNS_TEAM_ID=XXXXXXXXXX

# APNs topic — usually the iOS app's bundle identifier.
APNS_TOPIC=com.example.app

# APNs auth key IDs (10-char alphanumeric).
APNS_KEY_ID_DEV=XXXXXXXXXX
APNS_KEY_ID_PROD=XXXXXXXXXX

# Absolute paths to the .p8 key files (off the repo).
APNS_KEY_DEV_FILE=/path/to/AuthKey_DEV.p8
APNS_KEY_PROD_FILE=/path/to/AuthKey_PROD.p8

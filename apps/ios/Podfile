# Podfile — only used for SDKs we can't pull via SwiftPM.
#
# Currently a single dep: SpeechEngineToB (火山 Doubao 端到端实时语音). The
# rest of the iOS app's dependencies live in project.yml under `packages:`
# and are managed by SwiftPM via XcodeGen.
#
# Setup after a fresh clone:
#   1. brew install xcodegen cocoapods
#   2. cd apps/ios && xcodegen generate    # writes PendingBot.xcodeproj
#   3. pod install                         # writes Pods/ + PendingBot.xcworkspace
#   4. open PendingBot.xcworkspace         # NOT the .xcodeproj — Pods only attach to the workspace
#
# After step 3, work in the .xcworkspace. The .xcodeproj is still
# regenerated by XcodeGen when the YAML changes, but Pods integration
# survives because pod install rewrites the project's build phases each
# time it runs against the same target name.

source 'https://github.com/CocoaPods/Specs.git'
source 'https://github.com/volcengine/volcengine-specs.git'

platform :ios, '17.0'
use_frameworks!

target 'PendingBot' do
  # Doubao 端到端实时语音 SDK. iOS 12+ required by the pod spec — we ship
  # iOS 17 minimum so the constraint is satisfied trivially.
  # Docs: https://www.volcengine.com/docs/6561/1597646
  pod 'SpeechEngineToB', '0.0.14.6'
  # 0.0.14 dropped the TTNet network dependency in favor of SocketRocket.
  # Pin the version so a passive bump of one pod doesn't silently swap
  # the wire library underneath.
  pod 'SocketRocket', '0.6.1'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Match the app's deployment target so CocoaPods doesn't drag a
      # min-iOS warning into every build.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      # Catalyst support — voice calls on Mac are nice-to-have, not
      # required. Disable the Mac slice for SpeechEngineToB if it
      # surfaces dylib resolution errors during a Catalyst build.
      config.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
    end
  end
end

{
  // PendingBot Voice Agent — group-voice prototype.
  // ──────────────────────────────────────────────────────────────
  // A Cloudflare Realtime Agent (@cloudflare/realtime-agents): a server-
  // side AI participant that joins a RealtimeKit meeting. Audio pipeline
  // is RealtimeKit -> Deepgram STT -> Workers AI brain -> ElevenLabs TTS
  // -> RealtimeKit. See src/agent.ts.
  //
  // Single deployed env, no named environments — `wrangler dev` and
  // `wrangler deploy` both read this top-level config.

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pendingbot-voice-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Workers AI — the prototype brain (PendingBotBrain in src/agent.ts).
  "ai": {
    "binding": "AI"
  },

  // One agent Durable Object per meetingId (idFromName(meetingId)).
  "durable_objects": {
    "bindings": [
      { "name": "VOICE_AGENT", "class_name": "PendingBotVoiceAgent" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PendingBotVoiceAgent"]
    }
  ],

  "vars": {
    // Same Cloudflare account as the edge worker.
    "ACCOUNT_ID": "4c303754167f1f225e6761b5128c0d9f"
  }

  // Secrets (set via `wrangler secret put`, or `.dev.vars` for local dev):
  //
  //   CF_TOKEN             Cloudflare API token scoped "Realtime — Admin".
  //                        The agent pipeline backend is reached with it.
  //   DEEPGRAM_API_KEY     STT leg of the pipeline.
  //   ELEVENLABS_API_KEY   TTS leg of the pipeline.
  //   AGENT_INVOKE_SECRET  Shared secret required on POST /join + /leave
  //                        (sent as X-Agent-Secret) so only our own edge
  //                        worker can make the bot join a meeting.
}

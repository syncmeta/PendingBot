# PendingBot Admin — environment.
# Copy to `.env` for local dev; set the same keys as Cloudflare Pages
# environment variables (Pages → Settings → Environment variables) for prod.
# Vite only exposes vars prefixed with VITE_ to client code (import.meta.env).
# NONE of these are secrets in the service-role sense — the anon key is safe to
# ship to the browser (it's RLS-gated). NEVER put SUPABASE_SERVICE_ROLE_KEY here.

# Edge API base URL — every read/write goes through here (no direct Postgres).
# Routes live under <base>/v1/*.
VITE_EDGE_API_URL=https://bot.pendingname.com

# Supabase project URL + anon (public) key — used ONLY for Supabase Auth
# (email/password login → JWT). The JWT is then attached as Bearer to edge calls.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

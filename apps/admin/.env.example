# Supabase project (the same project the edge worker talks to).
# For local dev these come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser. Used to bypass RLS for
# admin reads/writes against pendingbot.llm_providers, audit_log, etc.
SUPABASE_SERVICE_ROLE_KEY=

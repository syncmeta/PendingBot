{
  "name": "@pendingbot/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PendingBot admin console — Refine SPA (block 4 of the dashboard stack). Deploys to Cloudflare Pages.",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "deploy": "echo 'admin ships with the edge worker: bun --filter=@pendingbot/edge run deploy' && exit 1"
  },
  "dependencies": {
    "@refinedev/antd": "^6",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "^5.81.5",
    "antd": "^5",
    "dayjs": "^1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "wrangler": "^4.97.0"
  }
}

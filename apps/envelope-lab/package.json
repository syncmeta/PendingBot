{
  "name": "@pendingbot/envelope-lab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Local web panel for 打磨 the 来信 (envelope) prompt + agent loop. Not deployed.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "web": "vite",
    "api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13",
    "hono": "^4",
    "openai": "^4",
    "react": "^18",
    "react-dom": "^18",
    "undici": "^8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}

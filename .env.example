# PendingBot self-hosting configuration inventory.
#
# This file is documentation, not a file every process loads automatically.
# Copy only the relevant section to the file named by that component:
#   apps/edge/.dev.vars, apps/admin/.env, or the environment of a one-off
#   script. Never commit populated copies.
# Every value below is a placeholder; no real credential belongs here.

# ── Edge Worker: core database and local runtime ───────────────────────────
# Managed by wrangler.jsonc; required at runtime. Use dev locally, production only on your deployment.
ENVIRONMENT="dev"
# Required for API/auth/data routes. Local value comes from `supabase status`.
SUPABASE_URL="http://127.0.0.1:54321"
# Required public client key. Copy the local publishable/anon key printed by `supabase status`.
SUPABASE_PUBLISHABLE_KEY="<local-supabase-publishable-or-anon-key>"
# Required server key with service-role privileges. Copy the local secret/service_role key from `supabase status`.
SUPABASE_SECRET_KEY="<local-supabase-secret-or-service-role-key>"
# Required for browser clients on another origin; set to the exact allowed local admin origin.
ALLOWED_ORIGIN="http://127.0.0.1:5174"

# ── Edge Worker: feature switches (optional, exact string true enables) ────
# Optional. false keeps billing gates/debits disabled; Polar/RevenueCat values are then unnecessary.
BILLING_ENABLED="false"
# Optional. false makes Sentry a no-op even when a DSN is present.
SENTRY_ENABLED="false"
# Optional. false makes PostHog a no-op even when a project key is present.
POSTHOG_ENABLED="false"
# Optional for tracing only. Prompt retrieval still requires Langfuse even when this is false.
LANGFUSE_ENABLED="false"

# ── Edge Worker: Cloudflare Access board gate (optional) ──────────────────
# Optional. Cloudflare Access team hostname; without both Access values, /v1/board/* fails closed.
CF_ACCESS_TEAM_DOMAIN="<team>.cloudflareaccess.com"
# Optional. Access application AUD tag from the Access application overview; pair with CF_ACCESS_TEAM_DOMAIN.
CF_ACCESS_AUD="<cloudflare-access-application-aud>"
# Optional. Comma-separated Access-verified admin emails; empty/unset denies all board API access.
BOARD_ADMIN_EMAILS="admin@example.com"

# ── Edge Worker: Cloudflare AI Gateway (required for LLM calls) ────────────
# Required for LLM routing. Cloudflare account ID from the dashboard URL/API overview.
CF_ACCOUNT_ID="<cloudflare-account-id>"
# Required for LLM routing. AI Gateway slug created in Cloudflare AI > AI Gateway.
CF_AIG_GATEWAY="<ai-gateway-slug>"
# Required for LLM routing. Authenticated Gateway run token from the gateway settings.
CF_AIG_RUN_TOKEN="<ai-gateway-run-token>"
# Optional. Cloudflare API token with AI Gateway Read; without it some provider costs stay unknown/skipped.
CF_AIG_TOKEN="<cloudflare-api-token-with-ai-gateway-read>"
# Optional/provider-specific. Stored BYOK alias for Google AI Studio; omit when using a default alias/unified billing.
GOOGLE_BYOK_ALIAS="<ai-gateway-google-byok-alias>"

# ── Edge Worker: Langfuse prompt source and tracing ────────────────────────
# Required for an empty self-host prompt cache. Project public key from Langfuse project settings.
LANGFUSE_PUBLIC_KEY="<langfuse-public-key>"
# Required with LANGFUSE_PUBLIC_KEY. Project secret key from Langfuse project settings.
LANGFUSE_SECRET_KEY="<langfuse-secret-key>"
# Required for self-hosted Langfuse; optional on cloud, where the SDK default may be used.
LANGFUSE_BASE_URL="https://<your-langfuse-host>"
# Optional. Shared HMAC secret configured on the Langfuse prompt webhook; without it updates use pull-on-miss only.
LANGFUSE_WEBHOOK_SECRET="<random-langfuse-webhook-secret>"

# ── Edge Worker: memory and web tools (optional for basic HTTP startup) ────
# Optional for basic startup, required for Honcho-backed memory/dialectic features. Create in the Honcho dashboard.
HONCHO_API_KEY="<honcho-api-key>"
# Optional with HONCHO_API_KEY. Workspace ID from the Honcho dashboard/SDK setup.
HONCHO_WORKSPACE_ID="<honcho-workspace-id>"
# Optional. Exa API key used by the seeded hosted MCP connector; without it Exa tools are not advertised/usable.
EXA_API_KEY="<exa-api-key>"
# Reserved/optional. Declared by Env but not wired to the default chat surface today.
TAVILY_API_KEY="<tavily-api-key>"

# ── Edge Worker: APNs push (optional) ─────────────────────────────────────
# Optional for non-push use. Apple Developer team ID used for APNs token auth.
APNS_TEAM_ID="<apple-team-id>"
# Optional for non-push use. APNs topic, normally the iOS bundle identifier.
APNS_TOPIC="<ios-bundle-id>"
# Optional. Key ID of the development APNs .p8 key from Apple Developer Certificates, IDs & Profiles.
APNS_KEY_ID_DEV="<development-apns-key-id>"
# Optional. Key ID of the production APNs .p8 key.
APNS_KEY_ID_PROD="<production-apns-key-id>"
# Optional secret. Full development .p8 PEM contents; use escaped newlines if the loader requires one line.
APNS_KEY_DEV="<development-apns-p8-pem>"
# Optional secret. Full production .p8 PEM contents.
APNS_KEY_PROD="<production-apns-p8-pem>"

# ── Edge Worker: voice and realtime (optional) ─────────────────────────────
# Optional for text-only use. OpenAI server API key for 1:1 and group Realtime voice.
OPENAI_API_KEY="<openai-api-key>"
# Optional for group voice; falls back to CF_ACCOUNT_ID when omitted.
REALTIMEKIT_ACCOUNT_ID="<cloudflare-realtimekit-account-id>"
# Optional for text/1:1 voice, required for group voice. RealtimeKit app ID.
REALTIMEKIT_APP_ID="<cloudflare-realtimekit-app-id>"
# Optional for text/1:1 voice, required for group voice. Token with Realtime Admin permission.
REALTIMEKIT_API_TOKEN="<cloudflare-realtimekit-api-token>"
# Optional. RealtimeKit human preset name; code has a starter default.
REALTIMEKIT_HUMAN_PRESET="group_call_host"
# Optional. RealtimeKit bot preset name; code has a starter default.
REALTIMEKIT_BOT_PRESET="group_call_participant"
# Optional. Cloudflare Realtime TURN key ID; without both TURN values auto transport falls back to WebSocket.
TURN_KEY_ID="<cloudflare-turn-key-id>"
# Optional. API token paired with TURN_KEY_ID.
TURN_KEY_API_TOKEN="<cloudflare-turn-api-token>"
# Required only for database-triggered realtime. Generate locally and set the same value in Supabase Vault.
REALTIME_WEBHOOK_SECRET="<random-realtime-webhook-secret>"

# ── Edge Worker: billing (optional when BILLING_ENABLED=false) ─────────────
# Optional. Polar organization access token; create a sandbox token for development.
POLAR_ACCESS_TOKEN="<polar-sandbox-access-token>"
# Optional. `sandbox` for local/testing or `production` for a live deployment.
POLAR_SERVER="sandbox"
# Optional. Polar webhook signing secret from the webhook endpoint configuration.
POLAR_WEBHOOK_SECRET="<polar-webhook-secret>"
# Optional. Polar meter ID used for PNC usage/wallet accounting.
POLAR_PNC_METER_ID="<polar-pnc-meter-id>"
# Optional. Exact shared Authorization header value configured for the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH="<random-revenuecat-webhook-authorization-value>"
# Optional developer-script override used only by polar-spike.ts/polar-verify.ts.
SPIKE_METER_ID="<polar-test-meter-id>"

# ── Edge Worker: observability (optional) ──────────────────────────────────
# Optional. Sentry JavaScript/Cloudflare Worker project DSN; also requires SENTRY_ENABLED=true.
SENTRY_DSN="<sentry-worker-dsn>"
# Optional. PostHog project API key; also requires POSTHOG_ENABLED=true.
POSTHOG_KEY="<posthog-project-api-key>"
# Optional. PostHog ingest host; set it for EU or self-hosted PostHog.
POSTHOG_HOST="https://<your-posthog-ingest-host>"

# ── Admin SPA (copy to apps/admin/.env only for separate Vite dev) ─────────
# Optional. Same-origin is the default; point Vite at the local edge worker when running on port 5174.
VITE_EDGE_API_URL="http://127.0.0.1:8787"

# ── Group-voice media container process (optional) ─────────────────────────
# Optional. HTTP/WS listen port; defaults to 8080 and normally comes from the container binding.
PORT="8080"
# Optional. Preferred chrome-headless-shell executable; Dockerfile sets /usr/bin/chromium-headless-shell.
CHROME_HEADLESS_SHELL_PATH="/usr/bin/chromium-headless-shell"
# Optional fallback Chromium executable when CHROME_HEADLESS_SHELL_PATH is absent.
CHROMIUM_PATH="<path-to-chromium>"

# ── Observability dashboards ───────────────────────────────────────────────
# Not shipped in this repo. Sentry / PostHog / Langfuse are configured above;
# anything beyond that (Grafana, Metabase, backups) is yours to wire up.
